# ===== RAG-KnowledgeBase 环境变量配置模板 =====
# 使用方式：复制本文件为 .env，填入真实值（切勿提交 .env）
#   cp .env.example .env

# --- MySQL 认证库连接（Web 多用户版必需）---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=rag_auth
RAG_SESSION_DAYS=7

# --- OpenAI 兼容 LLM ---
API_KEY=sk-your-openai-compatible-key
BASE_URL=https://api.openai.com/v1

# --- 联网检索（可选，缺省时系统自动禁用联网）---
BRAVE_SEARCH_API_KEY=
BOCHA_API_KEY=
QIANFAN_API_KEY=

# --- 可选：部署相关 ---
# RAG_USER_PORT=4010
# RAG_ADMIN_PORT=4011
# RAG_BIND_HOST=0.0.0.0
